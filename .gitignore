# Los PDFs pesan cientos de MB: viven en Cloudflare R2, no en git
# (GitHub rechaza archivos mayores a 100 MB)
docs/*.pdf

# Estado local de wrangler / node
.wrangler/
node_modules/

# El índice de búsqueda se genera con `node tools/indexar.mjs` a partir de
# los PDFs de docs/; pesa decenas de MB y viaja al desplegar, no por git.
public/indice/
